# Environment variables for AD Gene-Network Biomarker Discovery
# Copy to .env and fill values. Never commit real secrets.
# Backend is fail-closed: ranking endpoints abstain unless MODEL_RELEASE_APPROVED and APPROVED_ARTIFACT_REVISION are set.

# --- Backend release gate (fail-closed) ---
# Must be exactly "true" to enable serving rankings; any other value means abstain (safe default = off)
MODEL_RELEASE_APPROVED=false
# Non-empty revision string for the approved artifact (e.g. git SHA or version tag); required together with MODEL_RELEASE_APPROVED=true
APPROVED_ARTIFACT_REVISION=
# Path inside container/host to the trained model artifact (pickle/joblib)
MODEL_ARTIFACT_PATH=artifacts/model.joblib
# When true and release is approved but no artifact file exists, serve a synthetic demo ranking (for dev/tests only)
DEMO_MODE=false

# --- Backend auth (Firebase stub) ---
# Path to Firebase service-account JSON for real token verification; leave empty to use stub (any Bearer token -> stub user)
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Frontend ---
# Base URL for the backend API. Leave empty for same-origin / relative URL via Vite proxy. Example: http://localhost:8000
VITE_API_URL=
